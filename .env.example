# ==============================================================================
# OrderPulse AI — Environment Configuration Template
# Copy to .env and fill credentials for external managed services.
# Without external keys, the engine runs using deterministic local adapters.
# ==============================================================================

APP_NAME=OrderPulse AI
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# --- LLM Providers (Router/Guardrail & Multi-Agent Nodes) ---
LLM_PROVIDER=deterministic
LLM_MODEL_ROUTER=llama-3.3-70b-versatile
LLM_MODEL_AGENT=gpt-4o-mini
OPENAI_API_KEY=
GROQ_API_KEY=

# --- Performance & FinOps: Redis Semantic Cache ---
REDIS_URL=redis://localhost:6379/0
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.95
SEMANTIC_CACHE_TTL_SECONDS=86400

# --- Advanced Retrieval: Qdrant Vector Store + Hybrid RAG + Reranker ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=orderpulse_policies
RAG_TOP_K_INITIAL=15
RAG_TOP_K_RERANKED=3

# --- Operational Database (Read-Only Enforced) ---
POSTGRES_DSN=postgresql+asyncpg://orderpulse:orderpulse@localhost:5432/orderpulse_ops
SQL_READONLY_ENFORCED=true

# --- Business Governance & Human-in-the-Loop (HITL) ---
HITL_REFUND_THRESHOLD_BRL=150.00
MAX_REFUNDS_30D_ABUSE_THRESHOLD=4

# --- LLMOps Observability: Langfuse ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
